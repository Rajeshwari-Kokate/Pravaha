# PRAVAHA Environment Configuration Template

# Server settings
HOST=0.0.0.0
PORT=8000
DATASET_PATH=data/raw/flood_risk_dataset_india.csv
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional operator administration
# Protects history purge and contact log viewer with constant-time verification
ADMIN_PASSCODE=

# Gemma 4 LLM inference settings (OpenAI-compatible HTTP endpoint)
# Verified model identifier: google/gemma-4-E4B-it
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=google/gemma-4-E4B-it
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=30

# Optional SMTP configuration for contact notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pravaha.local

# Frontend build and API URL
VITE_API_BASE_URL=http://localhost:8000
VITE_BASE_PATH=/
